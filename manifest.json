{
  "manifest_version": 3,
  "name": "GitHub Advanced Viewer",
  "version": "0.1.0",
  "description": "Hide noise on GitHub pull requests: files like *.spec.ts and *.snap on Files changed, and resolved threads, bot comments and status events on Conversation. You always see what is hidden.",
  "minimum_chrome_version": "105",
  "permissions": ["storage"],
  "background": {
    "service_worker": "src/background.js"
  },
  "content_scripts": [
    {
      "matches": ["https://github.com/*"],
      "js": ["src/matcher.js", "src/storage.js", "src/diffstat.js", "src/content.js", "src/noise.js", "src/conversation.js"],
      "css": ["src/content.css"],
      "run_at": "document_end"
    }
  ],
  "action": {
    "default_title": "GitHub Advanced Viewer",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
